{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PEX",
  "version": "0.1.0",
  "identifier": "dev.pex.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PEX",
        "width": 920,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "pet",
        "title": "PEX pet",
        "url": "pet.html",
        "width": 280,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:7420 ws://127.0.0.1:7420",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self' customprotocol: asset:",
        "style-src": "'unsafe-inline' 'self'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:7420 ws://127.0.0.1:7420 http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self' customprotocol: asset:",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pex-bridge",
      "binaries/pex-cursor-hook",
      "binaries/pex-cursor-observe"
    ]
  }
}
