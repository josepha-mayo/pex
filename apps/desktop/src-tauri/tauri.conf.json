{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PEX",
  "version": "0.1.0",
  "identifier": "dev.pex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PEX",
        "width": 920,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false
      },
      {
        "label": "pet",
        "title": "PEX pet",
        "url": "pet.html",
        "width": 280,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
