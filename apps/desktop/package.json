  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare:sidecar": "node scripts/build-sidecar.mjs",
    "validate:pets": "node scripts/build-sidecar.mjs --validate-pets-only",
    "preflight:release": "node scripts/build-sidecar.mjs --preflight-release",
