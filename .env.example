PEX_HOME=
PEX_HOST=127.0.0.1
PEX_PORT=7420
PEX_AUTONOMY=manage
PEX_CLOUD_REASONING=true
PEX_REQUIRE_AUTH=true
PEX_SUPERVISOR_MODE=local
PEX_TOKEN=
# Local attention inbox at {PEX_HOME}/channels/inbox.jsonl. Telegram, Discord,
# WhatsApp, and Slack stay disconnected until a real adapter exists.
PEX_NOTIFY_FILE=true
AWS_REGION=eu-north-1

# AgentCore transport (required only for agentcore/hybrid mode). The bridge
# uses the normal AWS credential chain and SigV4; never paste AWS secrets here.
PEX_AGENTCORE_RUNTIME_ARN=
PEX_AGENTCORE_REGION=eu-north-1
PEX_AGENTCORE_QUALIFIER=DEFAULT
PEX_AGENTCORE_TIMEOUT_SECONDS=25

# Supervisor LLM (one provider is enough). Never commit real keys.
PEX_SUPERVISOR_PROVIDER=
PEX_SUPERVISOR_MODEL=
PEX_SUPERVISOR_API_KEY=
PEX_SUPERVISOR_BASE_URL=
PEX_SUPERVISOR_AUTH=api_key
PEX_SUPERVISOR_DISABLE=

# Optional named keys if you do not use PEX_SUPERVISOR_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
PEX_ZEN_API_KEY=
OPENCODE_API_KEY=
GROQ_API_KEY=

# Web search / scrape for verifying worker claims (BYOK)
FIRECRAWL_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
