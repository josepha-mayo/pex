{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python integrations/hooks/pex_hook.py --harness claude_code",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python integrations/hooks/pex_hook.py --harness claude_code",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python integrations/hooks/pex_hook.py --harness claude_code",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python integrations/hooks/pex_hook.py --harness claude_code",
            "timeout": 45
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python integrations/hooks/pex_hook.py --harness claude_code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
