{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py sessionStart", "timeout": 3 }],
    "sessionEnd": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py sessionEnd", "timeout": 3 }],
    "afterShellExecution": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py afterShellExecution", "timeout": 3 }],
    "afterFileEdit": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py afterFileEdit", "timeout": 3 }],
    "beforeSubmitPrompt": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py beforeSubmitPrompt", "timeout": 3 }],
    "preCompact": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py preCompact", "timeout": 3 }],
    "stop": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py stop", "timeout": 3, "loop_limit": null }],
    "afterAgentResponse": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py afterAgentResponse", "timeout": 3 }],
    "subagentStart": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py subagentStart", "timeout": 3 }],
    "subagentStop": [{ "command": "python -S integrations/cursor-hook/pex_cursor_observe.py subagentStop", "timeout": 3, "loop_limit": null }]
  }
}
